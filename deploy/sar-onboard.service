[Unit]
Description=SAHYOG SAR onboard autonomy loop
Documentation=file:///opt/sar/docs/HARDWARE_BRINGUP.md
# The autopilot link and the cameras must exist before we start.  Without this
# the service races the kernel on a cold boot, fails the preflight gate, and
# looks like a software fault.
After=network.target dev-sar\x2dautopilot.device
Wants=dev-sar\x2dautopilot.device

[Service]
Type=simple
User=sar
Group=sar
SupplementaryGroups=dialout video

WorkingDirectory=/opt/sar
Environment=PYTHONUNBUFFERED=1
Environment=MPLBACKEND=Agg
Environment=SAR_MODELS_DIR=/opt/sar/models
# Detector selection is a deployment decision: auto = neural where weights and a
# runtime exist, audited heuristic otherwise.
Environment=SAR_DETECTOR=auto

# The preflight gate runs first and exits non-zero if the aircraft is not fit to
# fly.  systemd then refuses to start the main loop, which is the behaviour we
# want: a companion computer that quietly starts a degraded perception loop is
# worse than one that visibly refuses.
ExecStartPre=/opt/sar/venv/bin/python /opt/sar/scripts/run_onboard.py \
    --config /etc/sar/onboard.yaml --mode flight --preflight-only

ExecStart=/opt/sar/venv/bin/python /opt/sar/scripts/run_onboard.py \
    --config /etc/sar/onboard.yaml --mode flight

# Restart, but not in a tight loop: if preflight keeps failing there is a real
# hardware problem and hammering it hides the logs.
Restart=on-failure
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=300

# The loop must not be starved by logging or housekeeping.  This is not a
# real-time priority - the flight controller owns the real-time work - but the
# perception cycle has a deadline and losing it costs coverage.
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2

# Filesystem containment.  The service needs exactly two writable paths.
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/sar /opt/sar/models
PrivateTmp=yes
NoNewPrivileges=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sar-onboard

[Install]
WantedBy=multi-user.target
