# ArduPilot SITL parameter profile for SAHYOG.
#
# Loaded with `arducopter --defaults configs/ardupilot_sitl.parm`.  This is
# deliberately NOT the hardware profile: SITL exposes every serial port whose
# protocol is overridden as a blocking TCP server and waits for a client before
# the vehicle will start, so the UART routing, ELRS and MSP-OSD settings that the
# real TBS Lucid H743 needs would hang the simulator.  Those live in
# `configs/ardupilot_hardware.parm`, which is what gets written to the board.
#
# What is shared between the two, and therefore what a simulation actually
# proves, is everything that changes vehicle behaviour: flight dynamics, the EKF
# source sets that make GPS-denied flight possible, the failsafe and fence
# envelope, the guided-mode speed limits, the battery model and the gripper
# wiring for the Drop-to-Confirm payload.
#
# ArduPilot SITL / TBS Lucid H743 Wing parameter profile for SAHYOG.
#
# One file, two uses.  Loaded into SITL with `--defaults`, and the same values
# are what get written to the physical board - so an algorithm proven against
# this profile is flying against this profile, rather than against a SITL
# configuration that happens to be more forgiving than the aircraft.
#
# The board is a TBS Lucid H743 Wing (STM32H743VIH6, 480 MHz) running ArduPilot
# Copter.  It has no internal compass, so the yaw source matters more than on a
# board that does, and EK3_SRC*_YAW is set explicitly rather than left to
# default.  Wiring follows the vendor hwdef:
#   SERIAL0  USB / MAVLink to the ground laptop
#   SERIAL2  GPS  (u-blox, 30+ sats in the open)
#   SERIAL4  Telem1 -> onboard AI computer, MAVLink 2 @ 921600
#   SERIAL6  ELRS receiver (CRSF)
#   SERIAL7  Telem2 -> spare / LoRa data modem
#   SERIAL8  ESC telemetry (4-in-1 ESC, bidirectional DShot)
#
# Battery is 6S with the onboard analogue monitor: VOLT_PIN 10, CURR_PIN 11,
# VOLT_MULT 11.0, AMP_PERVLT 40.0.

FRAME_CLASS,1
FRAME_TYPE,1
AHRS_EKF_TYPE,3
INS_ACCEL_FILTER,20
LOG_BITMASK,176126
LOG_DISARMED,1

# --- serial routing -------------------------------------------------------- #

# --- GPS ------------------------------------------------------------------- #
GPS_TYPE,1
GPS_AUTO_CONFIG,1
GPS_GNSS_MODE,0
GPS_RATE_MS,200
GPS_SBAS_MODE,2

# --- EKF3 source sets: the GPS-denied navigation path ---------------------- #
#
# The TBS Lucid H743 Wing has NO internal magnetometer, so COMPASS_ENABLE is 0
# and yaw comes from GNSS course, from the onboard visual-inertial odometry, or
# from the EKF's Gaussian Sum Filter - never from a compass.
#
# Three source sets are configured so that losing GNSS in flight is a single
# MAV_CMD_SET_EKF_SOURCE_SET (42007) command rather than a parameter write plus
# a filter reset.  That distinction is the whole basis of surviving a denial:
# during an EKF reset the vehicle has no position estimate at all, and at 60 m
# over a flooded street with people in the water that ends the sortie.
#
# The value spaces differ per axis and are NOT interchangeable.  Taken from
# libraries/AP_NavEKF/AP_NavEKF_Source.h, because the gaps are not where
# intuition puts them:
#
#   POSXY / VELXY : 0 NONE, 3 GPS, 4 BEACON, 5 OPTFLOW, 6 EXTNAV, 7 WHEEL
#                   (1 and 2 are reserved - "BARO = 1 (not applicable)")
#   POSZ          : 0 NONE, 1 BARO, 2 RANGEFINDER, 3 GPS, 4 BEACON, 6 EXTNAV
#   VELZ          : 0 NONE, 3 GPS, 6 EXTNAV  ONLY.  Baro, rangefinder and
#                   beacon are rejected here by the pre-arm check: a barometer
#                   gives height, not vertical speed.  So a set written as "all
#                   ones" passes POSZ and then fails at VELZ.
#   YAW           : 0 NONE, 1 COMPASS, 2 GPS, 3 GPS/COMPASS fallback,
#                   6 EXTNAV, 8 GSF
#
# YAW=1 (COMPASS) is accepted by the validator even with no compass present -
# ArduPilot skips that check "for easier user setup of compass-less operation" -
# so it is a silent misconfiguration rather than an error, and is never used
# here.  Likewise POSXY=1 is invalid and fails pre-arm with a bare
# "Check EK3_SRC1_POSXY" and no further explanation.
#
COMPASS_ENABLE,0

# Set 1 - normal operation: everything from GNSS.
EK3_SRC1_POSXY,3
EK3_SRC1_VELXY,3
EK3_SRC1_POSZ,3
EK3_SRC1_VELZ,3
EK3_SRC1_YAW,2

# Set 2 - GPS-denied: the onboard computer supplies position, velocity, vertical
# velocity and attitude from visual-inertial odometry (MAVLink ODOMETRY /
# VISION_POSITION_ESTIMATE at 20 Hz or better).  Height stays on the barometer
# deliberately: monocular VIO height drifts, and a barometer does not, so the
# one quantity that must not wander - the altitude that sets the ground sample
# distance - is held by the independent sensor.
EK3_SRC2_POSXY,6
EK3_SRC2_VELXY,6
EK3_SRC2_POSZ,1
EK3_SRC2_VELZ,6
EK3_SRC2_YAW,6

# Set 3 - no position aiding at all: optical-flow horizontal velocity with baro
# height, for a low confirmation pass under canopy or inside a structure where
# neither GNSS nor VIO features exist.  Position is deliberately NONE, which
# means the aircraft holds attitude and velocity but dead-reckons position - so
# this set is for short, low, supervised transits and not for survey.  Yaw comes
# from GSF, which derives heading from GPS *velocity* rather than position and so
# still works when the position solution has degraded past usefulness.
EK3_SRC3_POSXY,0
EK3_SRC3_VELXY,5
EK3_SRC3_POSZ,1
EK3_SRC3_VELZ,0
EK3_SRC3_YAW,8

# Bit 1: align the position of inactive source sets to the AHRS while optical
# flow is in use, so switching away from set 3 does not start from a stale
# origin.
EK3_SRC_OPTIONS,2

# --- sensors the source sets above depend on ------------------------------ #
#
# ArduPilot's pre-arm check validates that every sensor a *configured* source
# set names actually exists - not just the active one.  Naming optical flow in
# set 3 without a flow backend therefore blocks arming outright with
# "AHRS: EK3 sources require OpticalFlow", and naming external nav in set 2
# without VISO enabled fails with "EK3 sources require VisualOdom".
#
# Both are supplied by the same onboard computer over MAVLink, which is what
# makes source set 3 viable at all: there is no separate flow sensor in the
# airframe.  The companion computer runs the RGB and LWIR cameras, so visual
# odometry and optical flow are computed from imagery it already has and shipped
# as OPTICAL_FLOW_RAD / ODOMETRY.  That is also exactly the split a Qualcomm
# Flight RB5 or VOXL 2 platform is built for - and note VISO_TYPE has a
# dedicated VOXL backend (3) if one is used instead of a generic MAVLink VIO.
#
# VISO_TYPE : 0 None, 1 MAVLink, 2 IntelT265, 3 VOXL
# FLOW_TYPE : 0 None, 1 PX4Flow, 2 Pixart, 3 Bebop, 4 CXOF, 5 MAVLink,
#             6 DroneCAN, 7 MSP, 8 UPFLOW, 10 SITL
#
# FLOW_TYPE is 10 (SITL) here rather than 5 (MAVLink): the simulator has its
# own flow model, driven by SIM_FLOW_ENABLE/SIM_FLOW_RATE below.
VISO_TYPE,1
FLOW_TYPE,10
VISO_POS_M_NSE,0.15
VISO_VEL_M_NSE,0.15
VISO_YAW_NSE,0.10
FLOW_POS_M_NSE,0.15
FLOW_RATE,20

# --- battery: 6S, analogue monitor ---------------------------------------- #
BATT_MONITOR,0
BATT_VOLT_PIN,10
BATT_CURR_PIN,11
BATT_VOLT_MULT,11.0
BATT_AMP_PERVLT,40.0
BATT_CAPACITY,8000
BATT_ARM_VOLT,0
BATT_CRIT_VOLT,0
BATT_CRIT_MAH,0
BATT_LOW_VOLT,0
BATT_LOW_MAH,0
BATT_FS_LOW_ACT,0
BATT_FS_CRT_ACT,0
BATT_OPTIONS,1056

# --- RC: ELRS on SERIAL6 (CRSF) ------------------------------------------- #
RC_OPTIONS,32
THR_MID,500
THR_DZ,40

# --- arming and failsafes -------------------------------------------------- #
ARMING_REQUIRE,1
ARMING_CHECK,1
TERRAIN_ENABLE,0
ARMING_OPTIONS,0
FS_GCS_ENABLE,1
FS_GCS_TIMEOUT,5
FS_THR_ENABLE,1
FS_THR_VALUE,975
FS_VIBE_ENABLE,1
FS_CRASH_CHECK,1
FS_EKF_ACTION,1
FS_EKF_THRESH,0.8
FS_BATT_ENABLE,0
FENCE_ENABLE,0
FENCE_TYPE,7
FENCE_ALT_MAX,120
FENCE_RADIUS,300
FENCE_MARGIN,5
FENCE_ACTION,1
FENCE_AUTOENABLE,0

# --- guided-mode flight envelope ------------------------------------------ #
GUID_SPEED,8
WPNAV_SPEED,800
WPNAV_SPEED_DN,120
WPNAV_SPEED_UP,200
WPNAV_ACCEL,250
WPNAV_RADIUS,200
PILOT_SPEED_UP,250
PILOT_ACCEL_Z,250
ANGLE_MAX,3500
ATC_RATE_RP_MAX,180000
ATC_ACCEL_RP_MAX,90000
ATC_THR_HOVER,0.35
MOT_SPIN_ARM,0.10
MOT_SPIN_MIN,0.15
MOT_THST_EXPO,0.55
MOT_BAT_VOLT_MAX,25.2
MOT_BAT_VOLT_MIN,19.8

# --- mission and RTL ------------------------------------------------------- #
RTL_ALT,2500
RTL_ALT_TYPE,0
RTL_SPEED,800
RTL_CONE_SLOPE,3
MIS_OPTIONS,0
MIS_RESTART,0
AUTO_OPTIONS,3

# --- gripper / Drop-to-Confirm payload release ---------------------------- #
SERVO9_FUNCTION,59
GRIP_ENABLE,1
GRIP_TYPE,0
GRIP_GRAB,1100
GRIP_RELEASE,1900
RC9_OPTION,19

# --- OSD over the analogue VTX (MSP DisplayPort) -------------------------- #

# --- simulation-only ------------------------------------------------------- #
SIM_RC_FAIL,0
SIM_SPEEDUP,1
SIM_GPS_NUMSATS,30
SIM_GPS_HDOP,0.7
SIM_GPS_TYPE,1
SIM_BATT_VOLTAGE,24.9
SIM_BATTERY,1
SIM_FLOW_ENABLE,1
SIM_FLOW_RATE,20
SIM_FLOW_DELAY,0
SIM_TERRAIN,0
SIM_BARO_COUNT,2
SIM_IMU_COUNT,2
SIM_MAG_COUNT,0

# --- SITL-only corrections --------------------------------------------------
# The hardware profile sets RC_PROTOCOLS=1024 (CRSF, for the ELRS receiver) and
# enables terrain.  Neither exists in SITL: restricting the RC protocols removes
# the simulated receiver entirely ("PreArm: RC not found"), and the terrain
# server needs internet ("PreArm: waiting for terrain data").  Both are removed
# here and both are real requirements on the aircraft - which is exactly why the
# two profiles are separate files rather than one file with #ifdefs.

# Three of the hardware profile's settings cannot be honoured in SITL and each
# one blocks arming with a distinct message, so they are corrected here and the
# reason is recorded rather than silently differing from the aircraft:
#
#   RTL_ALT_TYPE=1 (above terrain)  -> "Arm: RTL_ALT_TYPE is above-terrain but
#       no terrain data".  Terrain needs a server; SIM_TERRAIN is off.  The real
#       aircraft keeps terrain-relative RTL, which is what you want over a flood
#       plain where the ground has changed since the map was made.
#
#   FENCE_ENABLE=1                  -> "Arm: Fence requires position".  Enabled
#       on the aircraft, where the geofence is a genuine safety requirement over
#       a populated disaster area.
#
#   BATT_MONITOR=4                  -> "Arm: Battery 1 below minimum arming
#       voltage".  SITL's simulated ADC does not match the real board's analogue
#       divider: VOLT_MULT=11.0 and VOLT_PIN=10 are properties of the Lucid
#       H743's hardware input, and SITL either reports the 65535 mV
#       "unavailable" sentinel or 0 V.  The monitor is disabled here and
#       BATT_ARM_VOLT set to 0.  Energy accounting for the mission comes from
#       sar/vehicle/power.py, which models the actual 6S 8000 mAh pack with
#       induced/parasite/profile power split, internal resistance sag and
#       temperature derate - a considerably better model than SITL's, and the one
#       the endurance numbers in the docs are taken from.  On the aircraft
#       BATT_MONITOR=4 with the divider pins, and 22.2 V (3.7 V/cell) is the
#       arming floor.

# With the battery monitor disabled for SITL, every battery failsafe that depends
# on it has to be disabled too - FS_BATT_ENABLE=2, BATT_FS_LOW_ACT=2 and
# BATT_FS_CRT_ACT=1 all ask the arming check to verify a monitor that is not
# there, and ArduPilot reports that as a bare "command 400 refused: FAILED" with
# no STATUSTEXT at all, which is the least debuggable failure mode in the whole
# stack.  The aircraft keeps all three enabled: a LiPo that sags below 3.5 V/cell
# under load is the single most common cause of a lost multirotor.
