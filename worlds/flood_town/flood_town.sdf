    <!-- SAR quadrotor: RGB + thermal + depth + LiDAR + nav sensors -->
    <model name="sar_drone">
      <pose>0 0 45 0 0 0</pose>
      <link name="body">
        <inertial><mass>2.4</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.09</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.55 0.55 0.18</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.55 0.55 0.18</size></box></geometry>
          <material><diffuse>0.9 0.25 0.15 1</diffuse></material></visual>
        <sensor name="rgb" type="camera">
          <camera><horizontal_fov>1.15</horizontal_fov>
            <image><width>1280</width><height>720</height></image>
            <clip><near>0.5</near><far>400</far></clip></camera>
          <always_on>true</always_on><update_rate>15</update_rate>
          <topic>/sar/rgb</topic>
        </sensor>
        <sensor name="thermal" type="thermal_camera">
          <camera><horizontal_fov>1.0</horizontal_fov>
            <image><width>320</width><height>240</height></image>
            <clip><near>0.5</near><far>400</far></clip></camera>
          <always_on>true</always_on><update_rate>9</update_rate>
          <topic>/sar/thermal</topic>
        </sensor>
        <sensor name="depth" type="depth_camera">
          <camera><horizontal_fov>1.15</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.5</near><far>120</far></clip></camera>
          <always_on>true</always_on><update_rate>10</update_rate>
          <topic>/sar/depth</topic>
        </sensor>
        <sensor name="lidar" type="gpu_lidar">
          <always_on>true</always_on><update_rate>10</update_rate>
          <topic>/sar/lidar</topic>
          <gz:sim:sensor><lidar><horizontal><samples>720</samples>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
            <vertical><samples>16</samples><min_angle>-0.26</min_angle>
            <max_angle>0.26</max_angle></vertical>
            <range><min>0.3</min><max>12.0</max></range></lidar></gz:sim:sensor>
        </sensor>
        <sensor name="imu" type="imu"><always_on>true</always_on>
          <update_rate>200</update_rate><topic>/sar/imu</topic></sensor>
        <sensor name="gps" type="navsat"><always_on>true</always_on>
          <update_rate>5</update_rate><topic>/sar/gps</topic></sensor>
      </link>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>sar</robotNamespace><jointName>rotor</jointName>
      </plugin>
    </model>

  </world>
</sdf>
